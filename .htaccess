# Block direct download of database files, SQL dumps, logs and docs
<FilesMatch "\.(db|sqlite|sqlite3|sql|log|md|json)$">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
  </IfModule>
</FilesMatch>

# Never serve the AI key file or local config directly
<FilesMatch "^(ai_config|config\.local)\.php$">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
  </IfModule>
</FilesMatch>

# Never list folder contents
Options -Indexes
